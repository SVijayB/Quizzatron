# Copy to .env.local and adjust. Only VITE_-prefixed vars reach the client.

# Base URL of the Quizzatron backend (REST + Socket.IO). No trailing slash.
#
# Defaults when unset:
#   npm run dev    -> http://localhost:5000
#   npm run build  -> https://quizzatron.onrender.com
#
# The Vite dev server also proxies /api and /socket.io to http://localhost:5000,
# so leaving this unset is the normal local setup.
VITE_API_BASE_URL=http://localhost:5000
