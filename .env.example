# Copy to .env and fill in what you need. Nothing here is required to run
# locally: with no keys at all the app boots and serves placeholder quizzes via
# the built-in offline model.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# LOCAL | DEVELOPMENT | TEST | PRODUCTION
FLASK_ENV=LOCAL
PORT=5000
# Defaults to 127.0.0.1 locally and 0.0.0.0 otherwise. Override to expose a
# local server on your LAN deliberately rather than by accident.
# HOST=127.0.0.1

# REQUIRED when FLASK_ENV is not a local environment. Generated per-process in
# local dev if unset, which means sessions don't survive a restart.
SECRET_KEY=

# Comma-separated allowlist for CORS and Socket.IO.
# Defaults: http://localhost:8080,http://127.0.0.1:8080 locally,
#           https://quizzatron.netlify.app in production.
# CORS_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------------
# Language models — set at least one key to generate real quizzes.
# /api/quiz/models only advertises models whose key is actually present.
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Allow the offline placeholder model. Defaults to on in local environments,
# off otherwise. Handy for frontend work with no credentials.
# ALLOW_OFFLINE_MODEL=1

# Provider model IDs move around. Override any registry entry without a code
# change using QUIZZATRON_MODEL_<KEY>, where <KEY> is the model key upper-cased
# with hyphens as underscores.
# QUIZZATRON_MODEL_GEMINI_FLASH=gemini-2.5-flash
# QUIZZATRON_MODEL_MISTRAL_LARGE=mistral-large-latest

# ---------------------------------------------------------------------------
# Optional: route through a LiteLLM proxy instead of provider SDKs.
# Run the gateway separately (`litellm --config config.yaml`, default port 4000).
# The litellm SDK is deliberately not an app dependency — see migration_plan.md.
# ---------------------------------------------------------------------------
# LITELLM_BASE_URL=http://0.0.0.0:4000
# LITELLM_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Optional: MongoDB for locally-hosted question banks.
# Absent or unreachable is fine — category listing degrades to OpenTDB only.
# ---------------------------------------------------------------------------
MONGO_CONNECTION_STRING=
# MONGO_DB_NAME=trivia-qa
# MONGO_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Optional limits (defaults shown)
# ---------------------------------------------------------------------------
# MAX_QUESTIONS=30
# MAX_UPLOAD_BYTES=10485760
# LLM_TIMEOUT_S=90
# LLM_OUTPUT_RETRIES=2
# MAX_PLAYERS_PER_LOBBY=8
# LOBBY_IDLE_TTL_S=3600
